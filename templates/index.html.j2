{% from "partials/summary.j2" import summary_strip %}
{% from "partials/repo_card.j2" import repo_card %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Repo Status</title>
<link rel="stylesheet" href="static/style.css">
</head>
<body>
<div class="wrap">

  <header class="page-header">
    <h1>Repo Status</h1>
    <p class="tagline">Pending changes and recent activity across tracked repositories.</p>
  </header>

  <main>
    {{ summary_strip(dashboard) }}

    <section class="repo-list" aria-label="Repositories">
      {% for repo in dashboard.repos %}
      {{ repo_card(repo) }}
      {% endfor %}
    </section>
  </main>

  <footer class="page-footer">
    <span>Generated: <time datetime="{{ dashboard.generated_at.isoformat() }}">{{ dashboard.generated_at | utc_stamp }}</time></span>
    <span class="footer-note">Rebuilt daily.</span>
  </footer>

</div>
</body>
</html>
